# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
*.crt

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.exe

# env files (Bảo mật: Không commit biến môi trường chứa API Key/Secret)
.env*
!.env.example

# vercel & turbopack
.vercel
.turbo

# IDE & Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# typescript
*.tsbuildinfo
next-env.d.ts

# User Data & Backups (Bảo mật dữ liệu từ vựng cá nhân của người học)
lexicon-backup-*.json
*.backup.json
*.export.json
*.userdata.json
